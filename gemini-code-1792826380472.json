{
  "name": "wave-scan-studio",
  "version": "1.0.0",
  "description": "Smart Scan and Document Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.wavestudio.app",
    "productName": "Wave Scan Studio",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wave Scan Studio"
    },
    "files": [
      "main.js",
      "index.html",
      "icon.ico"
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}